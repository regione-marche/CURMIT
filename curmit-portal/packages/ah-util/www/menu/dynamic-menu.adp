<master src="/packages/iter/www/master">
<property name="title">@title@</property>
<property name="context_bar">@context;noquote@</property>


<table align=center>
  <tr>
   <td align=left>
    <ul>
<multiple name="menu_items">
    <li><a href="@menu_items.path;noquote@">@menu_items.item_name;noquote@</a></li>
</multiple>
    </ul>
   </td>
  <tr>
</table>
