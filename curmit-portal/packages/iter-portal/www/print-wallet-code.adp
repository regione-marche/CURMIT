<html>
<body>
<table border="1" cellpadding="0" cellspacing="0" width="350" height="200">
    <tr>
      <td width="250" height="71" bordercolor="#FFFFFF"><font size=2 face="tahoma">
                                     <u>Nome</u>: @party_name@<br>
                                     </font></td>
      <td width="100" height="71" bordercolor="#FFFFFF"><img border="0" src="@logo_regione@" width="68" height="100"></td>
    </tr>
    <tr>
      <td width="350" height="53" colspan="2" bordercolor="#FFFFFF"><font size=2 face="tahoma">
                                     <u>Codice Portafoglio</u>: @wallet_id@<br>
                                    </font></td>
    </tr>
<!--    <tr>
      <td width="350" height="62" colspan="2" bordercolor="#FFFFFF"><img border="0" src="@logo@" width="310" height="60"></td>
    </tr> -->
  </table>
</body>
</html>
