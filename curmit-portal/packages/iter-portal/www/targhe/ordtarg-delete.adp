<master>
  <property name="title">@page_title@</property>
  <property name="context">@context;noquote@</property>

  <br>

  <h1>@page_title@</h1>

  <blockquote>
    <p>Se sei davvero sicuro di voler cancellare gli ordini di targhe che hai selezionato, premi conferma.<br>
      In caso contrario torna alla <a href="ordtarg-list?@link_list@">Lista Ordini Targhe</a>.<br>
    <p>
      <formtemplate id="ordtarg"></formtemplate>
  </blockquote>
  
