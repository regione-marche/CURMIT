<html>
<body>
  <table border="0" width="100%">
    <tr>
      <td width="35%" align="left"><img height=80 src=<%=[ns_info pageroot]%>/resources/img/@stampe_logo_nome@></td>
      <td width="65%" align="left">&nbsp;</td>
    </tr>
    <tr>
      <td width="35%" align="left">&nbsp;</td>
      <td width="65%" align="left">&nbsp;</td>
    </tr>
    <tr>
      <td width="35%" colspan=2 align="center"><b>PRENOTAZIONE TARGHE</b></td>
    </tr>
    <tr>
      <td width="35%" align="left">&nbsp;</td>
      <td width="65%" align="left">&nbsp;</td>
    </tr>
    <tr>
      <td width="35%" align="left"><b>Ditta</b>:</td>
      <td width="65%" align="left">@manutentore@</td>
    </tr>
    <tr>
      <td width="35%" align="left"><b>Cod.Prenotazione</b></td>
      <td width="65%" align="left">@cod_prenotazione@ del @data_prenotazione@</td>
    </tr>
    <tr>
      <td width="35%" align="left"><b>Num. Targhe</b>:</td>
      <td width="65%" align="left">@num_targhe@</td>
    </tr>
    <tr>
      <td width="35%" align="left">&nbsp;</td>
      <td width="65%" align="left">&nbsp;</td>
    </tr>
    <tr>
      <td width="35%" valign=top align="left"><b>Consegna</b>:</td>
      <td width="65%" align="left">@ritiro;noquote@</td>
    </tr>
    <!-- gab02 -->
    @nota;noquote@
  </table>
</body>
</html>
