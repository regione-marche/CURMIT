<html>
<body>
  <table border="0" width="100%">
    <tr>
      <td width="35%" align="left"><img height=20 src=<%=[ns_info pageroot]%>/resources/img/@stampe_logo_nome@></td>
      <td width="65%" align="left">&nbsp;</td>
    </tr>
    <tr>
      <td width="35%" align="left">&nbsp;</td>
      <td width="65%" align="left">&nbsp;</td>
    </tr>
    <tr>
      <td width="35%" colspan=2 align="center"><b>PRENOTAZIONE BOLLINI</b></td>
    </tr>
    <tr>
      <td width="35%" align="left">&nbsp;</td>
      <td width="65%" align="left">&nbsp;</td>
    </tr>
    <tr>
      <td width="35%" align="left"><b>Manutentore</b>:</td>
      <td width="65%" align="left">@manutentore@</td>
    </tr>
    <tr>
      <td width="35%" align="left"><b>Cod.Prenotazione</b></td>
      <td width="65%" align="left">@cod_prenotazione@ del @data_prenotazione@</td>
    </tr>
    <tr>
      <td width="35%" colspan=2 align="left">&nbsp;</td>
    </tr>
    <tr>
      <td width="35%" colspan=2 align="left"><b>IVA 10%</b></td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini fino a 100 kW:</td>
      <td width="65%" align="left">@num_boll_g@</td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini da 101 a 200 kW:</td>
      <td width="65%" align="left">@num_boll_f1@</td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini da 201 a 300 kW:</td>
      <td width="65%" align="left">@num_boll_f2@</td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini sup. a 300 kW:</td>
      <td width="65%" align="left">@num_boll_e@</td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini raffrescamento inf a 100 kW:</td>
      <td width="65%" align="left">@num_boll_freddo1@</td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini raffrescamento sup a 100 kW:</td>
      <td width="65%" align="left">@num_boll_freddo2@</td>
    </tr>
    <tr>
      <td width="35%" align="left"><b>Totale bollini iva 10%</b></td>
      <td width="65%" align="left">@totale_boll_iva_10@</td>
    </tr>
    <tr>
      <td width="35%" colspan=2 align="left">&nbsp;</td>
    </tr>
    <tr>
      <td width="35%" colspan=2 align="left"><b>IVA 22%</b></td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini fino a 100 kW:</td>
      <td width="65%" align="left">@num_boll_g_sec_iva@</td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini da 101 a 200 kW:</td>
      <td width="65%" align="left">@num_boll_f1_sec_iva@</td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini da 201 a 300 kW:</td>
      <td width="65%" align="left">@num_boll_f2_sec_iva@</td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini sup. a 300 kW:</td>
      <td width="65%" align="left">@num_boll_e_sec_iva@</td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini raffrescamento inf a 100 kW:</td>
      <td width="65%" align="left">@num_boll_freddo1_sec_iva@</td>
    </tr>
    <tr>
      <td width="35%" align="left">Num.bollini raffrescamento sup a 100 kW:</td>
      <td width="65%" align="left">@num_boll_freddo2_sec_iva@</td>
    </tr>
    <tr>
      <td width="35%" align="left"><b>Totale bollini iva 22%</b></td>
      <td width="65%" align="left">@totale_boll_iva_22@</td>
    </tr>

    <tr>
      <td width="35%" align="left"><b>Totale in Euro</b>:</td>
      <td width="65%" align="left">@importo@ - <b>@descr_agg@</b> </td>
    </tr>
<!--
    <tr>
      <td width="35%" align="left"><b>Num.bollini teleriscaldamento</b>:</td>
      <td width="65%" align="left">@num_boll_teleriscaldamento@</td>
    </tr> 
-->
    <tr>
      <td width="35%" align="left">&nbsp;</td>
      <td width="65%" align="left">&nbsp;</td>
    </tr>
    
    <tr>
      <td width="35%" valign=top align="left"><b>Consegna</b>:</td>
      <td width="65%" align="left">@ritiro;noquote@</td>
    </tr>
   <tr>
      <td width="35%" align="left">IBAN: UBI  BANCA</td>
      <td width="65%" align="left">IT 03 U 03111 02691 0000 0000 3670</td>

     </tr>
 <tr>
      <td width="35%" align="left">Indicando la causale:</td>
      <td width="65%" align="left">acquisto bollini Ditta: xxxx xxxx srl.</td>
    </tr>
  </table>
</body>
</html>
